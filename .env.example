# Copy to .env and fill in. .env is gitignored — no secrets belong in the repo.
# Stream keys are NOT here: they go into OBS only, never into a file the AI
# or this project can read.

# Twitch channel to read chat from (lowercase, no #). Blank = no Twitch chat.
TWITCH_CHANNEL=
# YouTube channel for live chat and Super Chats (@handle or channel ID).
# The live video is found automatically, so no video ID is needed.
YOUTUBE_CHANNEL=
# TikTok username, without the @. Blank = off (the library has crashed the
# process natively before, so it stays off unless deliberately enabled).
TIKTOK_USERNAME=

# Slay the Spire: character to auto-start (IRONCLAD/SILENT/DEFECT/WATCHER).
AUTO_START_CHARACTER=IRONCLAD

# Obsidian vaults where trial-and-error notes accumulate. One per game —
# they must be DIFFERENT folders. A Balatro brain reading Slay the Spire's
# notes (energy, block, relics) is worse than one reading nothing, so an
# empty BALATRO_VAULT disables notes rather than falling back.
OBSIDIAN_VAULT=D:\slay the spire
BALATRO_VAULT=D:\cardia balatro

# Hard cap on stream length, in hours. On reaching it Cardia says goodbye,
# stops the stream cleanly, saves and quits the game, and shuts everything
# down. Doubles as the subscription-usage safety net. 0 = no cap.
STREAM_MAX_HOURS=1.67
